# Application
APP_NAME=OSIF v2.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://osif:osif@localhost:5432/osif
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10

# API Server
API_HOST=0.0.0.0
API_PORT=6000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Worker
WORKER_CONCURRENCY=4
REQUEST_DELAY_MS=500

# External APIs
VT_API=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_SECRET_KEY=
CENSYS_APPID=
CENSYS_SECRET=
ABUSECH_API_KEY=
BITCOINABUSE_API_KEY=
WIGLE_API_NAME=
WIGLE_API_TOKEN=
SECURITY_TRAIL_API=

# Security (Phase 2)
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
