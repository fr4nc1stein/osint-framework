#!/usr/bin/env python3
import re
import sys
import os
import warnings
warnings.filterwarnings("ignore")

try:
    from sploitkit import *
    from tinyscript.helpers import is_bool, ExpiringDict, Path
    from tinyscript import *
except ImportError as e:
    print(f"[!] Missing dependency: {e}")
    print(f"    Install with: pip install -r requirements-console.txt")
    sys.exit(1)


class OsifConsole(FrameworkConsole):
    """OSIF v2 — Open Source Intelligence Framework Console"""
    exclude = ["root/test", "root/help"]
    sources  = {'banners': "banners"}


__all__    = ["OsifConsole"]
__script__ = "osif"
__doc__    = "OSIF console launcher."


def initialize_env():
    """First-run API key setup — writes .env if it doesn't exist."""
    env_path = os.path.join(os.path.dirname(__file__), ".env")
    if os.path.exists(env_path):
        return

    print("[*] No .env found. Let's configure your API keys (press Enter to skip any).")
    keys = [
        "SHODAN_API_KEY",
        "VIRUSTOTAL_API_KEY",
        "ABUSEIPDB_API_KEY",
        "HUNTER_API_KEY",
        "TOMBA_API_KEY",
        "HIBP_API_KEY",
        "ALIENVAULT_API_KEY",
        "CENSYS_API_KEY",
    ]
    with open(env_path, "w") as f:
        for key in keys:
            value = input(f"  {key}: ").strip()
            if value:
                f.write(f'{key}="{value}"\n')
    print("[+] .env created.\n")


def main():
    initialize(exit_at_interrupt=False)

    import argparse
    parser = argparse.ArgumentParser(description="OSIF console", add_help=False)
    parser.add_argument("-d", "--dev", action="store_true", help="enable development mode")
    args, _ = parser.parse_known_args()

    sys.tracebacklimit   = 0
    sys.dont_write_bytecode = True

    print("[*] Web interface is available at http://localhost:3000")
    print("[*] Backend API at http://localhost:6000/api/docs\n")

    c = OsifConsole(
        "OSIF",
        banner_section_styles={'title': {'fgcolor': "lolcat"}},
        dev=args.dev,
    )
    c.start()


if __name__ == '__main__':
    initialize_env()
    main()
