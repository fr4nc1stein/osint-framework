# OSIF v2 — Environment Configuration Example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Encryption ───────────────────────────────────────────────────────────────
# Required. Generate with:
# python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=""

# ── OSINT API Keys ────────────────────────────────────────────────────────────
# These can also be configured via the Integrations page in the UI.
# Keys saved via the UI are encrypted in PostgreSQL and take priority over these.

SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
TOMBA_API_KEY=""
TOMBA_SECRET_KEY=""
HIBP_API_KEY=""
HUNTER_API_KEY=""
IPINFO_TOKEN=""
ALIENVAULT_API_KEY=""
CENSYS_API_KEY=""
URLSCAN_API_KEY=""

# ── AI Provider (optional) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-4-6"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="2048"

# Frontend map provider
VITE_MAPBOX_TOKEN=""
OLLAMA_URL="http://localhost:11434"
